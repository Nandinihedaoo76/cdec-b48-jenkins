pipeline {
    agent any


    stages {
        stage('PULL'){
            steps{
                git branch: 'main', url: 'https://github.com/Nandinihedaoo76/cdz-infra.git'
            }
        }
        
        stage ('TEST'){
            steps{
                sh '''terraform init 
                terraform plan'''
            }
        }
        stage ('deploy'){
            steps{
               sh 'terraform apply --auto-approve'
            }
        }
    }
}